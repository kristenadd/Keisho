<?xml version="1.0" encoding="UTF-8"?>
<!-- Keisho's launch screen (iPhone, iPad): the Vision Pro icon's navy gradient
     filling the screen, and its logo as large as fits, 80% of the shorter side.
     The in-app splash (src/osd/launch_splash.mm) repeats it until the first
     frame is drawn. -->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="scene">
            <objects>
                <viewController id="launch" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="root">
                        <rect key="frame" x="0.0" y="0.0" width="852" height="393"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleToFill" image="LaunchBackground" translatesAutoresizingMaskIntoConstraints="NO" id="background">
                                <rect key="frame" x="0.0" y="0.0" width="852" height="393"/>
                            </imageView>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchLogo" translatesAutoresizingMaskIntoConstraints="NO" id="logo">
                                <rect key="frame" x="269" y="39" width="314" height="314"/>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.137" green="0.102" blue="0.267" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="background" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="bg-l"/>
                            <constraint firstItem="background" firstAttribute="trailing" secondItem="root" secondAttribute="trailing" id="bg-t"/>
                            <constraint firstItem="background" firstAttribute="top" secondItem="root" secondAttribute="top" id="bg-top"/>
                            <constraint firstItem="background" firstAttribute="bottom" secondItem="root" secondAttribute="bottom" id="bg-b"/>
                            <constraint firstItem="logo" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="logo-cx"/>
                            <constraint firstItem="logo" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="logo-cy"/>
                            <constraint firstItem="logo" firstAttribute="width" secondItem="logo" secondAttribute="height" multiplier="1" id="logo-square"/>
                            <constraint firstItem="logo" firstAttribute="width" relation="lessThanOrEqual" secondItem="root" secondAttribute="width" multiplier="0.8" id="logo-wmax"/>
                            <constraint firstItem="logo" firstAttribute="height" relation="lessThanOrEqual" secondItem="root" secondAttribute="height" multiplier="0.8" id="logo-hmax"/>
                            <constraint firstItem="logo" firstAttribute="width" secondItem="root" secondAttribute="width" multiplier="0.8" priority="750" id="logo-w"/>
                            <constraint firstItem="logo" firstAttribute="height" secondItem="root" secondAttribute="height" multiplier="0.8" priority="750" id="logo-h"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0" y="0"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchBackground" width="16" height="1024"/>
        <image name="LaunchLogo" width="1024" height="1024"/>
    </resources>
</document>

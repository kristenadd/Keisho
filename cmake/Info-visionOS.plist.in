<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Keisho</string>
    <key>CFBundleDisplayName</key>
    <string>Keisho</string>
    <key>CFBundleExecutable</key>
    <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key>
    <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
    <key>CFBundleVersion</key>
    <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key>
    <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>${SM2_IOS_PLATFORM}</string>
    </array>
    <key>MinimumOSVersion</key>
    <string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
    <!-- Apple Vision Pro. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>7</integer>
    </array>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
        <string>metal</string>
    </array>
    <!-- A window in the Shared Space, resized by its corner. Its shape is held
         to the picture's 4:3 or 16:9 (osd/vision_window.mm). -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UIApplicationPreferredDefaultSceneSessionRole</key>
        <string>UIWindowSceneSessionRoleApplication</string>
    </dict>
    <!-- The layered icon in Assets.car (data/visionos/Assets.xcassets). -->
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <string>AppIcon</string>
    </dict>
    <!-- The launch screen: its gradient and logo (data/launch/). -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <!-- ROMs go in the app's Documents folder: "On My iPhone > Keisho" in Files,
         or the Finder's device page over USB. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <!-- A game controller is the input; the system gives it to the app. -->
    <key>GCSupportsControllerUserInteraction</key>
    <true/>
    <key>GCSupportedGameControllers</key>
    <array>
        <dict>
            <key>ProfileName</key>
            <string>ExtendedGamepad</string>
        </dict>
    </array>
    <!-- A look and pinch reaches the overlay as a pointer. -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>GCSupportsGameMode</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.arcade-games</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
</dict>
</plist>

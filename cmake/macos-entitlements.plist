<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for a Developer ID (hardened runtime) build of Keisho.app.
  The dynarec maps its code buffer with MAP_JIT (src/cpu/jit/code_buffer.cpp),
  which the hardened runtime refuses without allow-jit.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
</dict>
</plist>
